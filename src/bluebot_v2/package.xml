<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>bluebot_v2</name>
  <version>0.1.0</version>
  <description>Minimal Bluebot v2 mapping stack using wheel odometry and LiDAR SLAM.</description>
  <maintainer email="hailey@todo.todo">hailey</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>launch</depend>
  <depend>launch_ros</depend>
  <depend>launch_xml</depend>
  <depend>ament_index_python</depend>
  <depend>ros2_serial_diff_drive_bridge</depend>
  <depend>lidar_launch</depend>
  <depend>slam_toolbox</depend>
  <depend>tf2_ros</depend>
  <depend>foxglove_bridge</depend>

  <exec_depend>nav2_map_server</exec_depend>
  <exec_depend>rviz2</exec_depend>

  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
