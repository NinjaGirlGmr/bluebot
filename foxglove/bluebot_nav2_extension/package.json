{
  "name": "bluebot_nav2_extension",
  "displayName": "BlueBot Nav2 Controls",
  "description": "Foxglove custom panel for BlueBot Nav2 goal publish, waypoint publish, and cancel controls.",
  "publisher": "BlueBot",
  "homepage": "https://github.com/hailey/bluebot",
  "version": "0.1.0",
  "main": "./dist/extension.js",
  "keywords": [
    "foxglove",
    "nav2",
    "ros2",
    "bluebot"
  ],
  "scripts": {
    "build": "foxglove-extension build",
    "foxglove:prepublish": "foxglove-extension build --mode production",
    "lint:ci": "eslint --report-unused-disable-directives .",
    "lint": "eslint --report-unused-disable-directives --fix .",
    "local-install": "foxglove-extension install",
    "package": "foxglove-extension package",
    "pretest": "foxglove-extension pretest"
  },
  "devDependencies": {
    "@foxglove/eslint-plugin": "1.0.0",
    "@foxglove/studio": "1.73.0",
    "@typescript-eslint/eslint-plugin": "6.7.5",
    "@typescript-eslint/parser": "6.7.5",
    "create-foxglove-extension": "1.0.3",
    "eslint": "8.51.0",
    "eslint-config-prettier": "8.10.0",
    "eslint-plugin-es": "4.1.0",
    "eslint-plugin-filenames": "1.3.2",
    "eslint-plugin-import": "2.28.1",
    "eslint-plugin-jest": "27.4.2",
    "eslint-plugin-prettier": "5.0.1",
    "eslint-plugin-react": "7.33.2",
    "eslint-plugin-react-hooks": "4.6.0",
    "prettier": "3.0.3",
    "typescript": "5.2.2"
  },
  "dependencies": {
    "@foxglove/rosmsg-msgs-common": "^3.1.0"
  }
}
