flowchart LR
%% ---------- STYLE DEFINITIONS ----------
classDef startup fill:#cce5ff,stroke:#3399ff,stroke-width:1px,color:#000;
classDef launch fill:#e8f4ff,stroke:#3399ff,stroke-width:1px,color:#000;
classDef sensors fill:#d4edda,stroke:#28a745,stroke-width:1px,color:#000;
classDef hardware fill:#d1ecf1,stroke:#17a2b8,stroke-width:1px,color:#000;
classDef state fill:#f0f0f0,stroke:#6c757d,stroke-width:1px,color:#000;
classDef mapping fill:#f8d7da,stroke:#dc3545,stroke-width:1px,color:#000;
classDef nav2 fill:#fce8e6,stroke:#dc3545,stroke-width:1px,color:#000;
classDef apriltag fill:#fff3cd,stroke:#ff9800,stroke-width:1px,color:#000;
classDef artifacts fill:#efe8ff,stroke:#6f42c1,stroke-width:1px,color:#000;

ENTRY["bluebot_bringup.sh"]:::startup
MODE_MAP["mode: mapping"]:::startup
MODE_NAV["mode: navigation {map}"]:::startup

ENTRY --> MODE_MAP
ENTRY --> MODE_NAV

%% ---------- SHARED BUILDING BLOCKS ----------
SENS["sensors.launch.py\n(rplidar + imu + static TFs)"]:::sensors
DRIVE["Drive stack\nserial bridge + serial_diff_drive_hw"]:::hardware
LOCAL_EKF["robot_localization_filter\n/odom_raw + imu -> /odom"]:::state
STRAIGHT["straight_line_compensator\n/cmd_vel -> /cmd_vel_compensated"]:::state

MODE_MAP --> SENS
MODE_MAP --> DRIVE
MODE_MAP --> LOCAL_EKF
MODE_MAP --> STRAIGHT

MODE_NAV --> SENS
MODE_NAV --> DRIVE
MODE_NAV --> LOCAL_EKF
MODE_NAV --> STRAIGHT

%% ---------- MAPPING BRANCH ----------
MAP_LAUNCH["robot_bringup/mapping.launch.py"]:::launch
SLAM["slam_toolbox mapping\n/map + map->odom TF"]:::mapping
MAP_REC["apriltag_map_recorder (optional)\n/tag_detections + TF + /odom"]:::apriltag
SAVE["save-map\nmap_saver_cli + landmarks copy"]:::artifacts
ART_MAP["{map}.yaml"]:::artifacts
ART_TAGS["{map}.apriltags.yaml"]:::artifacts

MODE_MAP --> MAP_LAUNCH
MAP_LAUNCH --> SLAM
MAP_LAUNCH --> MAP_REC
SLAM --> SAVE --> ART_MAP
MAP_REC --> SAVE --> ART_TAGS

%% ---------- NAVIGATION BRANCH ----------
NAV_LAUNCH["robot_bringup/navigation.launch.py"]:::launch
NAV2_LAUNCH["included nav2.launch.py"]:::launch
NAV2_STACK["nav2_bringup + smoother_server\n(map_server, amcl, planner, controller, BT)"]:::nav2
GLOBAL_EKF["robot_localization_global_filter\n/odom + /apriltag/map_pose + /initialpose\n-> map->odom TF"]:::state
GRID_LOC["isaac_grid_localization_to_nav2\n-> /initialpose"]:::apriltag
AT_TF["apriltag_landmark_tf_publisher\nloads {map}.apriltags.yaml"]:::apriltag
AT_LOC["apriltag_map_localization\n/tag_detections -> /apriltag/map_pose"]:::apriltag
AT_CAM["apriltag_realsense.launch.py (optional)"]:::apriltag
AT_BT["apriltag_nav_behavior_tree"]:::apriltag

MODE_NAV --> NAV_LAUNCH
NAV_LAUNCH --> NAV2_LAUNCH --> NAV2_STACK
NAV_LAUNCH --> GRID_LOC
NAV_LAUNCH --> AT_TF
NAV_LAUNCH --> AT_LOC
NAV_LAUNCH --> AT_CAM
NAV_LAUNCH --> AT_BT

ART_MAP --> NAV_LAUNCH
ART_TAGS --> AT_TF
LOCAL_EKF --> GLOBAL_EKF
AT_LOC --> GLOBAL_EKF
GRID_LOC --> GLOBAL_EKF
GLOBAL_EKF --> NAV2_STACK

AT_CAM --> AT_LOC
AT_BT --> NAV2_STACK

%% ---------- DOCKING (NAVIGATION BRANCH) ----------
DOCK_DET["dock_detector_node\n/tag_detections -> /detected_dock_pose"]:::apriltag
DOCK_CMD["dock_command_node\n/dock_command topic -> docking action"]:::apriltag
DOCK_SRV["opennav_docking server\n(SimpleChargingDock)"]:::apriltag
GOAL_SAN["goal_pose_sanitizer_node\n/goal_pose -> map frame + fresh stamp"]:::apriltag

NAV_LAUNCH --> DOCK_DET
NAV_LAUNCH --> DOCK_CMD
NAV_LAUNCH --> DOCK_SRV
NAV_LAUNCH --> GOAL_SAN
AT_CAM --> DOCK_DET
DOCK_DET --> DOCK_SRV
DOCK_CMD --> DOCK_SRV
GOAL_SAN --> NAV2_STACK

%% ---------- NOTE ----------
NOTE["Legacy packages bluebot_v2 / bluebot_v3 are removed.\nstraight_line_compensator_node now lives in robot_bringup."]:::artifacts
ENTRY --- NOTE
