flowchart TD
%% ---------- STYLE DEFINITIONS ----------
classDef startup fill:#cce5ff,stroke:#3399ff,stroke-width:1px,color:#000;
classDef launch fill:#e8f4ff,stroke:#3399ff,stroke-width:1px,color:#000;
classDef sensors fill:#d4edda,stroke:#28a745,stroke-width:1px,color:#000;
classDef hardware fill:#d1ecf1,stroke:#17a2b8,stroke-width:1px,color:#000;
classDef nav2 fill:#f8d7da,stroke:#dc3545,stroke-width:1px,color:#000;
classDef state fill:#f0f0f0,stroke:#6c757d,stroke-width:1px,color:#000;
classDef apriltag fill:#fff3cd,stroke:#ff9800,stroke-width:1px,color:#000;
classDef ops fill:#efe8ff,stroke:#6f42c1,stroke-width:1px,color:#000;

%% ---------- ENTRYPOINT ----------
A["bluebot_bringup.sh start navigation {map}"]:::startup
B["robot_bringup/navigation.launch.py\nmap:=/maps/{name}.yaml"]:::launch

%% ---------- SHARED SENSORS ----------
S1["sensors.launch.py\nLidar + IMU + sensor TFs"]:::sensors

%% ---------- NAV2 INCLUDE ----------
subgraph NAV2INC["Included: nav2.launch.py"]
N1["ros2_serial_diff_drive_bridge + serial_diff_drive_hw"]:::hardware
N2["robot_localization_filter (local EKF)\n/odom_raw + imu -> /odom"]:::state
N3["robot_localization_global_filter (global EKF)\n/odom + /apriltag/map_pose + /initialpose\n-> /odometry/global + map->odom TF"]:::state
N4["straight_line_compensator\n/cmd_vel -> /cmd_vel_compensated"]:::state
N5["SetParametersFromFile\nconfig/nav2_smoother.yaml"]:::nav2
N6["nav2_bringup/bringup_launch.py"]:::nav2
N7["Nav2 lifecycle nodes\nmap_server, amcl(tf_broadcast=false),\nplanner, controller, bt_navigator,\nbehavior_server, waypoint_follower, smoother_server"]:::nav2
N8["health_monitor (nav2 profile)"]:::ops
end

%% ---------- APRILTAG + GLOBAL LOCALIZATION ----------
AT0["apriltag_realsense.launch.py (optional)\n/tag_detections"]:::apriltag
AT1["apriltag_landmark_tf_publisher\nloads {map}.apriltags.yaml -> static TFs"]:::apriltag
AT2["apriltag_map_localization\n/tag_detections + TF + landmarks -> /apriltag/map_pose"]:::apriltag
AT3["isaac_grid_localization_to_nav2 (default enabled)\n/localization_result -> /initialpose"]:::apriltag
AT4["apriltag_nav_behavior_tree\nrules + landmarks + map actions"]:::apriltag

%% ---------- FLOW ----------
A --> B

B -->|includes| S1
B -->|includes| NAV2INC
B -->|optional| AT0
B -->|starts| AT1
B -->|starts| AT2
B -->|default enabled| AT3
B -->|default enabled| AT4

N1 -->|/odom_raw| N2
N4 -->|/cmd_vel_compensated| N1
N2 -->|/odom| N3
N2 -->|/odom| N6
N5 --> N6
N6 --> N7

AT0 -->|/tag_detections| AT2
AT1 -->|map landmark TFs| AT2
AT2 -->|pose0=/apriltag/map_pose| N3
AT3 -->|pose1=/initialpose| N3
AT3 -->|/initialpose| N7

N3 -->|map->odom TF| N7
AT4 -->|may publish /initialpose or nav actions| N7
N8 --> N6
